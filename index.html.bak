        </section>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-top">
                <div class="footer-brand">
                    <div class="brand-logo">
                        <span class="logo-icon"><i class="fa-solid fa-microphone-lines"></i></span>
                        <span class="logo-text">IGL<span class="logo-accent">LATENT</span></span>
                    </div>
                    <p class="footer-desc">
                        The ultimate horizontal streaming platform for India's Got Latent Season 1, Season 2, and free VIP Vault specials. Built with anti-download protection for Google Drive video streams.
                    </p>
                </div>

                <div class="footer-nav-col">
                    <h4>Series Navigation</h4>
                    <ul>
                        <li><a href="#season1Section" class="footer-link"><i class="fa-solid fa-microphone"></i> Season 1 (Episodes 1-12)</a></li>
                        <li><a href="#season2Section" class="footer-link"><i class="fa-solid fa-fire"></i> Season 2 (Episodes 1-12)</a></li>
                        <li><a href="#vipSection" class="footer-link"><i class="fa-solid fa-crown"></i> 💎 VIP Uncut Vault (Free)</a></li>
                    </ul>
                </div>

                <div class="footer-nav-col">
                    <h4>Streaming & Settings</h4>
                    <ul>
                        <li><a href="#season1Section" class="footer-link"><i class="fa-solid fa-play"></i> High-Speed Web Playback</a></li>
                        <li><a href="#" id="footerSupportLink"><i class="fa-solid fa-mug-hot"></i> Support the Developer (Buy a Chai)</a></li>
                        
                        <li><a href="#" id="footerResetLink"><i class="fa-solid fa-clock-rotate-left"></i> Reset Episode Cache</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <p>© 2026 INDIA'S GOT LATENT STREAM. All rights reserved. Ultra HD Cinema Streaming Platform.</p>
                <div class="footer-security-badges">
                    <span class="badge-item"><i class="fa-solid fa-shield-check"></i> Right-Click Protected</span>
                    <span class="badge-item"><i class="fa-solid fa-ban"></i> No Downloads Allowed</span>
                    <span class="badge-item"><i class="fa-solid fa-gem"></i> 100% Free Streaming</span>
                </div>
            </div>
        </div>
    </footer>

        <!-- ======================================================== -->
    <!-- DEVELOPER CONTRIBUTION / BUY ME A CHAI QR MODAL          -->
    <!-- (Shown before playing any video)                         -->
    <!-- ======================================================== -->
    <div class="donate-modal" id="donateModal" aria-hidden="true" role="dialog">
        <div class="modal-backdrop" id="donateBackdrop"></div>
        <div class="donate-dialog">
            <button class="btn-close-donate" id="closeDonateBtn" title="Close & Watch">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <div class="donate-header">
                <div class="donate-icon-badge">
                    <i class="fa-solid fa-mug-hot"></i>
                </div>
                <div class="donate-badge-pill">
                    <i class="fa-solid fa-heart"></i> <span>SUPPORT THE DEVELOPER</span>
                </div>
                <h3 class="donate-title">Enjoying India's Got Latent?</h3>
                <p class="donate-subtitle">
                    100% ad-free & uncensored stream! If you appreciate the platform, consider buying a chai to help keep the stream fast and alive. 💖
                </p>
            </div>

            <div class="donate-body">
                <!-- Left Column: QR Code Display Card -->
                <div class="donate-qr-card">
                    <div class="qr-glow-wrapper">
                        <!-- Lightweight WebP QR code with PNG fallback -->
                        <picture>
                            <source srcset="assets/developer_qr.webp" type="image/webp">
                            <img 
                                src="assets/developer_qr.png" 
                                alt="Scan QR to Support Developer" 
                                id="developerQrImg" 
                                class="developer-qr-img"
                                width="200"
                                height="200"
                                loading="lazy"
                                decoding="async">
                        </picture>
                    </div>
                    <div class="qr-scan-label">
                        <i class="fa-solid fa-qrcode"></i> Scan with any UPI App
                    </div>
                    <span class="qr-scan-sublabel">Instant auto-verification</span>
                </div>

                <!-- Right Column: Payment Details & Direct Redirect -->
                <div class="donate-details-card">
                    <!-- Step 1: Select Tier -->
                    <div class="detail-section">
                        <span class="detail-section-label">
                            <i class="fa-solid fa-mug-hot"></i> Choose Contribution Amount
                        </span>
                        <div class="chai-tier-grid">
                            <button class="chai-tier-btn active" data-amount="20">
                                <span class="tier-icon">☕</span>
                                <span class="tier-val">₹20</span>
                                <span class="tier-name">Chai</span>
                            </button>
                            <button class="chai-tier-btn" data-amount="50">
                                <span class="tier-icon">🧋</span>
                                <span class="tier-val">₹50</span>
                                <span class="tier-name">Coffee</span>
                            </button>
                            <button class="chai-tier-btn" data-amount="100">
                                <span class="tier-icon">🍕</span>
                                <span class="tier-val">₹100</span>
                                <span class="tier-name">Snacks</span>
                            </button>
                            <button class="chai-tier-btn" data-amount="custom">
                                <span class="tier-icon">❤️</span>
                                <span class="tier-val">Custom</span>
                                <span class="tier-name">Any Amt</span>
                            </button>
                        </div>
                    </div>

                    <!-- Step 2: Instant 1-Tap UPI Pay Button -->
                    <div class="detail-section">
                        <a href="upi://pay?pa=siddharthakumar109-2@okhdfcbank&pn=Siddhartha%20Gautam&cu=INR&am=20" class="btn-pay-intent" id="payViaUpiAppBtn" title="Launch Installed UPI App">
                            <span class="pay-intent-icon"><i class="fa-solid fa-bolt"></i></span>
                            <span class="pay-intent-text">Pay <strong id="payTierAmountDisplay">₹20</strong> via UPI App</span>
                            <i class="fa-solid fa-arrow-up-right-from-square arrow-icon"></i>
                        </a>

                        <div class="upi-apps-row">
                            <span class="upi-apps-label">Or open directly:</span>
                            <a href="upi://pay?pa=siddharthakumar109-2@okhdfcbank&pn=Siddhartha%20Gautam&cu=INR&am=20" class="upi-app-pill upi-intent-link" data-app="gpay" title="Open Google Pay"><i class="fa-brands fa-google-pay"></i> GPay</a>
                            <a href="upi://pay?pa=siddharthakumar109-2@okhdfcbank&pn=Siddhartha%20Gautam&cu=INR&am=20" class="upi-app-pill upi-intent-link" data-app="phonepe" title="Open PhonePe"><i class="fa-solid fa-bolt"></i> PhonePe</a>
                            <a href="upi://pay?pa=siddharthakumar109-2@okhdfcbank&pn=Siddhartha%20Gautam&cu=INR&am=20" class="upi-app-pill upi-intent-link" data-app="paytm" title="Open Paytm"><i class="fa-solid fa-wallet"></i> Paytm</a>
                            <a href="upi://pay?pa=siddharthakumar109-2@okhdfcbank&pn=Siddhartha%20Gautam&cu=INR&am=20" class="upi-app-pill upi-intent-link" data-app="bhim" title="Open BHIM"><i class="fa-solid fa-building-columns"></i> BHIM</a>
                        </div>
                    </div>

                    <!-- Step 3: Desktop Manual UPI Copy -->
                    <div class="upi-box">
                        <div class="upi-label-row">
                            <span class="upi-label">UPI ID: Siddhartha Gautam</span>
                        </div>
                        <div class="upi-row">
                            <code class="upi-text" id="upiIdText">siddharthakumar109-2@okhdfcbank</code>
                            <button class="btn-copy-upi" id="copyUpiBtn" title="Copy UPI ID">
                                <i class="fa-regular fa-copy"></i> <span id="copyBtnText">Copy</span>
                            </button>
                        </div>
                    </div>

                    <!-- Target Preview -->
                    <div class="qr-target-preview">
                        <i class="fa-solid fa-circle-play"></i>
                        <div class="qr-target-text">
                            <span class="target-head">Next Up:</span>
                            <strong id="donateEpisodeTitle" class="target-title">Episode Title</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="donate-footer">
                <button class="btn-contributed-action" id="donateContributedBtn">
                    <i class="fa-solid fa-heart"></i> I Have Contributed!
                </button>
                <button class="btn-continue-play" id="donateContinueBtn">
                    <span>Continue to Video</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- CINEMA VIDEO PLAYER MODAL (Anti-Download Protected)       -->
    <!-- ======================================================== -->
    <div class="player-modal" id="playerModal" aria-hidden="true" role="dialog">
        <div class="player-modal-backdrop" id="playerBackdrop"></div>
        
        <div class="player-container">
            <!-- Cinema Player Header -->
            <div class="player-header">
                <div class="player-header-info">
                    <span class="player-tag" id="playerEpisodeTag">S1 • E01</span>
                    <h3 class="player-title" id="playerEpisodeTitle">Episode Title</h3>
                    <span class="badge-protected"><i class="fa-solid fa-shield-halved"></i> Ultra HD 1080p • Protected Stream</span>
                </div>
                <div class="player-header-actions">
                    <button class="player-ctrl-btn btn-fullscreen-player" id="fullscreenPlayerBtn" title="Fullscreen">
                        <i class="fa-solid fa-up-right-and-down-left-and-up-left-to-down-right"></i>
                    </button>
                    <button class="player-ctrl-btn" id="toggleTheaterBtn" title="Theater Mode">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                    <button class="player-ctrl-btn btn-close-player" id="closePlayerBtn" title="Close (Esc)">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>

            <!-- Video Wrapper with Top Shielding Mask -->
            <div class="video-frame-wrapper" id="videoWrapper">
                <!-- TOP SHIELD OVERLAY: Intercepts clicks on Google Drive's pop-out & download buttons -->
                <div class="anti-download-shield" id="antiDownloadShield">
                    <div class="shield-watermark">
                        <i class="fa-solid fa-shield-halved"></i> INDIA'S GOT LATENT • PROTECTED STREAM • NO DOWNLOAD
                    </div>
                </div>

                <!-- Google Drive Preview Iframe -->
                <iframe 
                    id="driveVideoIframe"
                    src="about:blank"
                    title="Protected Video Stream"
                    allow="autoplay; fullscreen"
                    allowfullscreen>
                </iframe>

                <!-- Video Stream Error / Retry Overlay -->
                <div class="video-error-overlay hidden" id="videoErrorOverlay">
                    <div class="video-error-card">
                        <i class="fa-solid fa-triangle-exclamation error-icon"></i>
                        <h4>Video Stream Temporarily Unavailable</h4>
                        <p id="videoErrorMessage">The stream could not be loaded or your network timed out. Please click below to reload the player.</p>
                        <div class="video-error-actions">
                            <button class="btn-retry-video" id="retryVideoBtn">
                                <i class="fa-solid fa-rotate-right"></i> Try Again
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Episode Coming Soon Overlay -->
                <div class="unloaded-notice-overlay hidden" id="unloadedNoticeOverlay">
                    <div class="unloaded-card">
                        <div class="unloaded-pill"><i class="fa-solid fa-clock"></i> COMING SOON</div>
                        <h3 id="unloadedTitle">Episode Coming Soon</h3>
                        <p class="unloaded-desc">This unedited episode is currently being processed for streaming. However, <strong>Season 1 Episodes 1, 2, and 3</strong> are fully uploaded and ready to watch right now!</p>
                        
                        <div class="unloaded-quick-watch">
                            <span class="quick-watch-label">Stream Available Episodes Now:</span>
                            <div class="quick-watch-buttons">
                                <button type="button" class="btn-quick-stream" data-stream-id="s1-e01">
                                    <i class="fa-solid fa-circle-play"></i> Ep 1: Pilot Chaos (1080p)
                                </button>
                                <button type="button" class="btn-quick-stream" data-stream-id="s1-e02">
                                    <i class="fa-solid fa-circle-play"></i> Ep 2: Roast & Latents (1080p)
                                </button>
                                <button type="button" class="btn-quick-stream" data-stream-id="s1-e03">
                                    <i class="fa-solid fa-circle-play"></i> Ep 3: Neuroscience (1080p)
                                </button>
                            </div>
                        </div>

                        <div class="unloaded-actions">
                            <button type="button" class="btn-quick-stream" id="unloadedBackBtn" style="background: rgba(255,255,255,0.1); border-color: var(--border-subtle); cursor: pointer;">
                                <i class="fa-solid fa-xmark"></i> Back to Episode Guide
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Demo notice banner if URL is sample -->
                <div class="sample-notice-banner hidden" id="sampleNoticeBanner">
                    <div class="sample-notice-inner">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>This episode is currently using a sample link. To connect your real Google Drive video, click <strong>"Manage Drive Links"</strong> in the top menu.</span>
                    </div>
                </div>
            </div>

            <!-- Video Footer Controls & Next Episode Drawer -->
            <div class="player-footer">
                <div class="player-footer-left">
                    <button class="btn-player-nav" id="prevEpisodeBtn">
                        <i class="fa-solid fa-backward-step"></i> Previous Episode
                    </button>
                    <button class="btn-player-nav" id="nextEpisodeBtn">
                        Next Episode <i class="fa-solid fa-forward-step"></i>
                    </button>
                    <label class="auto-play-toggle">
                        <input type="checkbox" id="autoNextCheck" checked>
                        <span>Auto-play Next Episode</span>
                    </label>
                </div>

                <div class="player-footer-right">
                    <button class="btn-player-action" id="markWatchedBtn">
                        <i class="fa-regular fa-circle-check"></i> <span id="markWatchedText">Mark as Watched</span>
                    </button>
                    <button class="btn-player-action" id="toggleEpisodeListBtn">
                        <i class="fa-solid fa-list-ul"></i> Episode Selector
                    </button>
                </div>
            </div>

            <!-- In-Player Episode Quick Switch Drawer -->
            <div class="player-episode-drawer hidden" id="playerEpisodeDrawer">
                <div class="drawer-header">
                    <h4><i class="fa-solid fa-microphone-lines"></i> Quick Episode Switch</h4>
                    <button class="btn-close-drawer" id="closeDrawerBtn"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="drawer-episode-list" id="drawerEpisodeList">
                    <!-- Dynamic Drawer Cards -->
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    
                    <div class="master-drive-input-row">
                        <div class="input-with-icon">
                            <i class="fa-solid fa-folder-tree"></i>
                            <input type="text" id="masterDriveFolderInput" value="https://drive.google.com/drive/folders/1AermIto6wOKAT_rHowr4629uE5g0gYsU" placeholder="Storage folder URL or ID...">
                        </div>
                        <button type="button" class="btn-apply-folder" id="applyFolderToAllBtn" title="Apply this storage ID to all episodes">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> Link to All Episodes
                        </button>
                    </div>
                </div>

                <!-- Instructions Bar -->
                <div class="admin-info-box">
                    <i class="fa-solid fa-lightbulb"></i>
                    <div>
                        <strong>Video Source Setup:</strong> Enter individual file IDs or links. Storage backend remains completely invisible to viewers and plays directly inside the website.
                    </div>
                </div>

                <!-- Season Selection Tabs inside Admin -->
                <div class="admin-season-tabs">
                    <button class="admin-tab active" data-admin-season="1" id="adminTabS1">Season 1 (12 Episodes)</button>
                    <button class="admin-tab" data-admin-season="2" id="adminTabS2">Season 2 (12 Episodes)</button>
                    <button class="admin-tab" data-admin-season="VIP" id="adminTabVIP">💎 VIP Vault (6 Specials)</button>
                </div>

                <!-- Quick Batch Search / Filter -->
                <div class="admin-search-bar">
                    <input type="text" id="adminFilterInput" placeholder="Filter by episode title or number...">
                </div>

                <!-- Episode Edit List -->
                <div class="admin-episodes-container" id="adminEpisodesList">
                    <!-- Form items rendered via JavaScript -->
                </div>
            </div>

            <div class="modal-footer">
                <div class="modal-footer-left">
                    <button class="btn-danger-outline" id="resetDataBtn" title="Restore default sample episode data">
                        <i class="fa-solid fa-rotate-left"></i> Reset Defaults
                    </button>
                    <button class="btn-secondary-outline" id="exportDataBtn" title="Export episodes to JSON file">
                        <i class="fa-solid fa-file-export"></i> Backup JSON
                    </button>
                </div>
                <div class="modal-footer-right">
                    <button class="btn-secondary-action" id="cancelAdminBtn">Cancel</button>
                    <button class="btn-primary-play" id="saveAllLinksBtn">
                        <i class="fa-solid fa-floppy-disk"></i> Save All Links
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Scripts (deferred for non-render-blocking execution) -->
    <script src="data.js?v=9" defer></script>
    <script src="app.js?v=9" defer></script>
</body>
</html>
