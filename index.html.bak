<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>INDIA'S GOT LATENT (IGL) - Full Episodes Season 1, Season 2 & VIP Uncut Vault</title>
    <meta name="description" content="Watch India's Got Latent full episodes online hosted by Samay Raina with all-star celebrity judges. Stream Season 1, Season 2 and VIP Uncut Vault in HD with zero download risk.">
    
    <!-- Optimized Resource Hints -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="image" href="assets/hero_banner.webp" type="image/webp" fetchpriority="high">
    
    <!-- Google Fonts (Essential weights only with display=swap) -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@700;800;900&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons (Non-render-blocking with noscript fallback) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>
    
    <link rel="stylesheet" href="styles.css?v=4">
</head>
<body oncontextmenu="return false;" ondragstart="return false;">
    <!-- Ambient Background Glows (India's Got Latent Studio Glow) -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
    <div class="ambient-glow glow-3"></div>

    <!-- Top Navigation Bar -->
    <header class="navbar" id="navbar">
        <div class="nav-container">
            <div class="nav-left">
                <a href="#home" class="brand-logo" id="brandLogo">
                    <span class="logo-icon"><i class="fa-solid fa-microphone-lines"></i></span>
                    <span class="logo-text">IGL<span class="logo-accent">LATENT</span></span>
                    <span class="logo-badge">UNCENSORED</span>
                </a>
                <nav class="nav-links">
                    <a href="#home" class="nav-link active"><i class="fa-solid fa-house"></i> Home</a>
                    <a href="#season1Section" class="nav-link"><i class="fa-solid fa-microphone"></i> Season 1 (12)</a>
                    <a href="#season2Section" class="nav-link"><i class="fa-solid fa-fire"></i> Season 2 (12)</a>
                    <a href="#vipSection" class="nav-link vip-nav-link">
                        <i class="fa-solid fa-crown"></i> VIP Vault <span class="badge-free">100% FREE</span>
                    </a>
                </nav>
            </div>

            <div class="nav-right">
                <!-- Search Bar -->
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="searchInput" placeholder="Search episodes, guests, latent tags..." autocomplete="off">
                    <button class="clear-search-btn" id="clearSearchBtn" title="Clear search"><i class="fa-solid fa-xmark"></i></button>
                </div>

                <!-- Support Developer Button (Chai Contribution) -->
                <button class="btn-donate-nav" id="navSupportBtn" title="Support Developer / Buy a Chai">
                    <i class="fa-solid fa-mug-hot"></i>
                    <span>Support Dev</span>
                </button>

                
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="main-wrapper">
        <!-- Hero Spotlight Section -->
        <section class="hero-section" id="home">
            <div class="hero-backdrop" id="heroBackdrop">
                <img 
                            src="assets/qr.jpg" 
                            alt="Scan QR to Support Siddhartha Gautam" 
                            id="developerQrImg" 
                            class="developer-qr-img"
                            width="210"
                            height="290"
                            loading="eager"
                            decoding="async">
                <div class="hero-gradient-overlay"></div>
            </div>

            <div class="hero-content">
                <div class="hero-badges">
                    <span class="pill-badge series-type"><i class="fa-solid fa-fire"></i> SHOW EXCLUSIVE</span>
                    <span class="pill-badge ready-badge"><i class="fa-solid fa-bolt"></i> 3 EPISODES READY TO STREAM</span>
                    <span class="pill-badge quality-badge"><i class="fa-solid fa-tv"></i> 4K FULL HD</span>
                    <span class="pill-badge dolby-badge"><i class="fa-solid fa-microphone-lines"></i> HOST: SAMAY RAINA</span>
                    <span class="pill-badge age-badge">18+ UNCENSORED</span>
                    <span class="pill-badge buzzer-badge"><i class="fa-solid fa-bell"></i> RED BUZZER READY</span>
                    <span class="pill-badge free-badge"><i class="fa-solid fa-crown"></i> VIP VAULT INCLUDED</span>
                </div>

                <h1 class="hero-title" id="seriesTitle">INDIA'S GOT LATENT</h1>
                <p class="hero-tagline" id="seriesTagline">Rate Your Latent Talent • Complete Season 1, Season 2 & VIP Vault</p>

                <div class="hero-meta">
                    <span class="meta-item"><i class="fa-solid fa-star rating-star"></i> <strong>9.9</strong> / 10 Audience Score</span>
                    <span class="meta-item"><i class="fa-solid fa-calendar-days"></i> 2024 - 2025</span>
                    <span class="meta-item"><i class="fa-solid fa-layer-group"></i> 2 Seasons • 30 Uncut Episodes</span>
                    <span class="meta-item"><i class="fa-solid fa-closed-captioning"></i> Ultra HD 4K</span>
                </div>

                <p class="hero-synopsis" id="seriesSynopsis">
                    India's wildest comedy talent show where contestants put their bizarre and latent talents on the line in front of Samay Raina and an all-star comic panel! From outrageous mimicry and mind games to unexpected musical acts, contestants guess their own latent score from 1 to 10 to win cash prizes. Stream every episode with zero download risks, seamless horizontal navigation, and full unedited cuts.
                </p>

                <div class="hero-actions">
                    <button class="btn-primary-play" id="heroPlayS1Btn">
                        <i class="fa-solid fa-play"></i> Watch Episode 1: Pilot
                    </button>
                    <a href="#season1Section" class="btn-secondary-action">
                        <i class="fa-solid fa-layer-group"></i> Browse Episodes
                    </a>
                    <a href="#season2Section" class="btn-secondary-action" id="heroPlayS2Btn">
                        <i class="fa-solid fa-fire"></i> Season 2 Latents
                    </a>
                    <a href="#vipSection" class="btn-vip-action" id="heroVipBtn">
                        <i class="fa-solid fa-crown"></i> 💎 VIP Uncut Vault (100% Free)
                    </a>
                </div>
            </div>

            <!-- Floating Stream Stat Card -->
            <div class="hero-stat-card">
                <div class="stat-item">
                    <span class="stat-number">24</span>
                    <span class="stat-label">Main Episodes</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <span class="stat-number">06</span>
                    <span class="stat-label">VIP Specials (Free)</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <span class="stat-number" id="statsWatched">0</span>
                    <span class="stat-label">Watched Episodes</span>
                </div>
            </div>
        </section>

        <!-- Studio Stream Status Bar -->
        <section class="stream-studio-bar">
            <div class="studio-bar-container">
                <div class="studio-bar-left">
                    <span class="studio-status-dot"></span>
                    <span class="studio-brand">IGL LATENT ARENA</span>
                    <span class="studio-separator">/</span>
                    <span class="studio-status-text">Samay Raina's Uncut Direct Stream • Private Non-Download Network</span>
                </div>
            </div>
        </section>

        <!-- Search Results Section (Shown only when searching) -->
        <section class="slider-section search-results-section hidden" id="searchSection">
            <div class="section-row-header">
                <div class="row-header-left">
                    <h2 class="row-title">
                        <span class="row-glow-bar"></span>
                        Search Results for "<span id="searchResultQueryText"></span>"
                    </h2>
                    <p class="row-subtitle" id="searchResultCountText">Found matching episodes</p>
                </div>
                <div class="row-header-right">
                    <button class="btn-text-reset" id="resetSearchBtn"><i class="fa-solid fa-rotate-left"></i> Clear Search</button>
                    <div class="slider-nav-btns">
                        <button class="slider-btn-prev" data-target="searchTrack" aria-label="Slide Left"><i class="fa-solid fa-chevron-left"></i></button>
                        <button class="slider-btn-next" data-target="searchTrack" aria-label="Slide Right"><i class="fa-solid fa-chevron-right"></i></button>
                    </div>
                </div>
            </div>
            <div class="slider-viewport">
                <button class="floating-nav-arrow float-arrow-left" data-target="searchTrack" aria-label="Slide Left"><i class="fa-solid fa-chevron-left"></i></button>
                <div class="horizontal-slider-track" id="searchTrack">
                    <!-- Dynamic Search Cards -->
                </div>
                <button class="floating-nav-arrow float-arrow-right" data-target="searchTrack" aria-label="Slide Right"><i class="fa-solid fa-chevron-right"></i></button>
            </div>
        </section>

        <!-- ======================================================== -->
        <!-- HORIZONTAL SLIDABLE ROWS                                 -->
        <!-- ======================================================== -->

        <!-- ROW 1: SEASON 1 SLIDER -->
        <section class="slider-section" id="season1Section">
            <div class="section-row-header">
                <div class="row-header-left">
                    <h2 class="row-title">
                        <span class="row-glow-bar season1-glow"></span>
                        <i class="fa-solid fa-microphone-lines title-icon"></i> Season 1: The OG Panel & Auditions
                    </h2>
                    <span class="row-badge">12 Full Episodes • Uncut</span>
                    <span class="row-badge row-badge-live"><i class="fa-solid fa-circle"></i> EPISODES 1-3 STREAM READY (1080P)</span>
                    <p class="row-subtitle">Tanmay Bhat, Kunal Kamra, Raghu Ram, Seedhe Maut & iconic pilot moments</p>
                </div>
                <div class="row-header-right">
                    <span class="slider-counter" id="s1SliderCounter">Slide to explore</span>
                    <div class="slider-nav-btns">
                        <button class="slider-btn-prev" data-target="season1Track" aria-label="Slide Left" title="Previous Episodes">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <button class="slider-btn-next" data-target="season1Track" aria-label="Slide Right" title="Next Episodes">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="slider-viewport">
                <button class="floating-nav-arrow float-arrow-left" data-target="season1Track" aria-label="Previous Episodes">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <div class="horizontal-slider-track" id="season1Track">
                    <!-- Season 1 Episodes injected via JS -->
                </div>
                <button class="floating-nav-arrow float-arrow-right" data-target="season1Track" aria-label="Next Episodes">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </section>

        <!-- ROW 2: SEASON 2 SLIDER -->
        <section class="slider-section" id="season2Section">
            <div class="section-row-header">
                <div class="row-header-left">
                    <h2 class="row-title">
                        <span class="row-glow-bar season2-glow"></span>
                        <i class="fa-solid fa-fire title-icon s2-icon"></i> Season 2: Unhinged Chaos & New Latents
                    </h2>
                    <span class="row-badge s2-badge">12 Blockbuster Episodes • 4K HDR</span>
                    <p class="row-subtitle">Higher stakes, merciless red buzzers, and the legendary 10/10 scoring syncs</p>
                </div>
                <div class="row-header-right">
                    <span class="slider-counter" id="s2SliderCounter">Slide to explore</span>
                    <div class="slider-nav-btns">
                        <button class="slider-btn-prev" data-target="season2Track" aria-label="Slide Left" title="Previous Episodes">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <button class="slider-btn-next" data-target="season2Track" aria-label="Slide Right" title="Next Episodes">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="slider-viewport">
                <button class="floating-nav-arrow float-arrow-left" data-target="season2Track" aria-label="Previous Episodes">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <div class="horizontal-slider-track" id="season2Track">
                    <!-- Season 2 Episodes injected via JS -->
                </div>
                <button class="floating-nav-arrow float-arrow-right" data-target="season2Track" aria-label="Next Episodes">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </section>

        <!-- ROW 3: VIP PREMIUM VAULT SLIDER (100% FREE ACCESS) -->
        <section class="slider-section vip-slider-section" id="vipSection">
            <div class="section-row-header vip-row-header">
                <div class="row-header-left">
                    <div class="vip-header-badge-row">
                        <span class="highlight-badge"><i class="fa-solid fa-gem"></i> VIP EXCLUSIVE</span>
                        <span class="badge-free"><i class="fa-solid fa-gift"></i> 100% FREE ACCESS</span>
                    </div>
                    <h2 class="row-title vip-title">
                        <span class="row-glow-bar vip-glow"></span>
                        <i class="fa-solid fa-crown title-icon vip-icon-gold"></i> VIP Latent Vault: Uncut & Backstage Specials
                    </h2>
                    <p class="row-subtitle vip-subtitle">Green room roasts, bizarre rejected audition tapes, red buzzer compilations & Raghu Ram deliberations — completely free with zero subscription charges!</p>
                </div>
                <div class="row-header-right">
                    <span class="slider-counter vip-counter" id="vipSliderCounter">6 Free Specials</span>
                    <div class="slider-nav-btns">
                        <button class="slider-btn-prev vip-btn-nav" data-target="vipTrack" aria-label="Slide Left" title="Previous Specials">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <button class="slider-btn-next vip-btn-nav" data-target="vipTrack" aria-label="Slide Right" title="Next Specials">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="slider-viewport vip-viewport">
                <button class="floating-nav-arrow float-arrow-left vip-float-arrow" data-target="vipTrack" aria-label="Previous Specials">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <div class="horizontal-slider-track vip-track" id="vipTrack">
                    <!-- VIP Specials injected via JS -->
                </div>
                <button class="floating-nav-arrow float-arrow-right vip-float-arrow" data-target="vipTrack" aria-label="Next Specials">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
